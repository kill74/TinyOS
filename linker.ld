ENTRY(_start)

SECTIONS
{
    . = 1M;

    /* Multiboot header must be early in the binary for bootloaders to find it. */
    .multiboot :
    {
        *(.multiboot)
    }

    .text :
    {
        *(.text*)
    }

    .rodata :
    {
        *(.rodata*)
    }

    .data :
    {
        *(.data*)
    }

    .bss :
    {
        *(COMMON)
        *(.bss*)
    }
}
